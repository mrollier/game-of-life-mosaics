hf_space/

# Paper draft — kept off the public repository
paper/

# Beyond-tiles spike run outputs (curated figures live in experiments/beyond_tiles/figures/)
experiments/beyond_tiles/results/

# LinkedIn banner variation set: 50 renders and four contact sheets, ~16 MB and
# regenerated in under a minute by experiments/beyond_tiles/linkedin_banners.py
# from the committed .npz assets. The chosen render and the before/after figure
# are kept in experiments/beyond_tiles/figures/ instead.
output/images/linkedin/

# PhD-defence flyer study (experiments/beyond_tiles/flyer.py): the two finished
# designs (vignette2, skyline2) in every palette are kept with their Golly
# exports. Previews, zooms, contact and palette sheets, the archived first two
# rounds and the dropped designs (skyline, antipodes, arch) are regenerated
# from the saved solves and stay local.
output/images/flyer/_*
!output/images/flyer/_palette_skyline2_*.png
output/images/flyer/_palette_skyline2_teal.png
output/images/flyer/round*/
output/images/flyer/skyline-*.png
output/images/flyer/antipodes-*.png
output/golly/flyer-skyline-*.cells
output/golly/flyer-antipodes-*.cells

# Search campaign artifacts (checkpoints, local oracle copy, big outputs).
# The completeness certificates (161 MB) are regenerated by certify.py and
# archived outside git; see search/tiles/README.md for their hashes.
search/tiles/work/
search/tiles/reference/
search/tiles/tiles_diamond_level_*.npy
search/tiles/solutions_pattern_level_*.npy
search/tiles/tools/
search/tiles/counts/
search/tiles/certificates/
search/nosym/work_nosym/
search/nosym/tiles_diamond_nosym_level_*.npy
