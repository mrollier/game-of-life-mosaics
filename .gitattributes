# Auto detect text files and perform LF normalisation
* text=auto

# Byte-exact files. Golly patterns and SAT certificates are hashed and
# diffed as published; a CRLF checkout on Windows would change both.
*.cells -text
*.rle -text
*.cnf -text
*.drat -text

# Binary data
*.npy binary
*.npz binary
*.png binary
*.gif binary

# Research notebooks are versioned without outputs; `nbstripout --install
# --attributes .gitattributes` (see CONTRIBUTING.md) makes git strip them
# on commit. Tutorials keep their outputs so they render on GitHub.
# The diff line hides outputs from `git diff`, and its presence also stops
# that install command from appending catch-all `*.ipynb` rules here.
notebooks/research/**/*.ipynb filter=nbstripout
notebooks/research/**/*.ipynb diff=ipynb
